---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import ReadingLayout from '../../components/layout/ReadingLayout.astro';
import MetaBadges from '../../components/content/MetaBadges.astro';
import RelatedLinks from '../../components/content/RelatedLinks.astro';
import Callout from '../../components/content/Callout.astro';
import Mermaid from '../../components/content/Mermaid.astro';
import Ask from '../../components/content/Ask.astro';
import Answer from '../../components/content/Answer.astro';
import Explain from '../../components/content/Explain.astro';
import { COLLECTION_TYPES, typeColor, trackColor } from '../../lib/types';
import { getAll, usedIn } from '../../lib/content';

export const getStaticPaths = (async () => {
  const paths = [];
  for (const type of COLLECTION_TYPES) {
    const entries = await getAll(type as any) as any[];
    for (const entry of entries) paths.push({ params: { type, slug: entry.id }, props: { entry } });
  }
  return paths;
}) satisfies GetStaticPaths;

const { entry } = Astro.props as { entry: any };
const d = entry.data;
const { Content, headings } = await render(entry);
const components = { Callout, Mermaid, Ask, Answer, Explain };

const kicker = d.type === 'session' ? `Session · ${d.exercise}` :
  d.module ? `${d.module}` : d.skill ? `${d.skill}` : d.type;
const kickerColor = d.type === 'track' ? trackColor(entry.id) :
  d.track ? trackColor(d.track) : typeColor(d.type);
const trackLabel = d.track;
const related = [...(d.prerequisites ?? []), ...(d.related ?? [])];
const usedInLinks = d.type === 'concept' ? await usedIn(d.id) : [];

// For a track page, gather its lessons + exercises so the page isn't a dead end.
const byId = (a: any, b: any) => String(a.data.id).localeCompare(String(b.data.id));
const trackLessons = d.type === 'track'
  ? (await getAll('lessons') as any[]).filter((x) => x.data.track === entry.id).sort(byId) : [];
const trackExercises = d.type === 'track'
  ? (await getAll('exercises') as any[]).filter((x) => x.data.track === entry.id).sort(byId) : [];

// Prev/next within a track so lessons read as a continuous course (easy -> expert).
let prevLesson: any = null, nextLesson: any = null;
if (d.type === 'lesson') {
  const sibs = (await getAll('lessons') as any[]).filter((x) => x.data.track === d.track).sort(byId);
  const i = sibs.findIndex((x) => x.data.id === d.id);
  if (i > 0) prevLesson = sibs[i - 1];
  if (i >= 0 && i < sibs.length - 1) nextLesson = sibs[i + 1];
}
---
<ReadingLayout title={d.title} kicker={kicker} kickerColor={kickerColor} trackLabel={trackLabel}
  headings={headings.filter((h: any) => h.depth === 2).map((h: any) => ({ text: h.text, slug: h.slug }))}>
  <div class="anim mt-6">
    <MetaBadges type={d.type} status={d.status} level={d.level} minutes={d.estimatedMinutes} reviewedBy={d.reviewedBy} score={d.score} hideType={kicker === d.type} />
  </div>
  <div class="anim my-9 flex items-center gap-1.5" aria-hidden="true">
    <span class="w-10 h-px bg-stone-300 dark:bg-stone-700"></span>
    <span class="w-1 h-1 rounded-full bg-stone-300 dark:bg-stone-700"></span>
  </div>
  {/* [&>h1:first-child]:hidden — nhiều doc mở đầu body bằng `# <title>` trùng với
      title đã render từ frontmatter ở trên; ẩn đúng h1 đứng đầu, giữ h1 giữa bài. */}
  <div class="anim read-body text-stone-700 dark:text-stone-300 prose dark:prose-invert max-w-none prose-headings:font-read [&>h1:first-child]:hidden">
    <Content components={components} />
  </div>
  {d.type === 'track' && (trackLessons.length > 0 || trackExercises.length > 0) && (
    <div class="anim mt-14 space-y-10">
      {trackLessons.length > 0 && (
        <section>
          <div class="flex items-center gap-3 mb-4">
            <span class="eyebrow">lessons — học theo thứ tự</span>
            <span class="flex-1 h-px bg-stone-200 dark:bg-stone-800"></span>
          </div>
          <ol class="space-y-1">
            {trackLessons.map((l: any, i: number) => (
              <li>
                <a href={`/lessons/${l.id}`} class="group flex items-center gap-4 px-4 py-3 rounded-lg hover:bg-stone-100/70 dark:hover:bg-stone-900/70 transition-colors text-sm">
                  <span class="font-read italic text-stone-300 dark:text-stone-600 tabular-nums w-6 shrink-0">{String(i + 1).padStart(2, '0')}</span>
                  <span class="flex-1 text-stone-700 dark:text-stone-300 group-hover:text-brand transition-colors">{l.data.title}</span>
                  {l.data.level && <span class="text-xs text-stone-400">{l.data.level}</span>}
                </a>
              </li>
            ))}
          </ol>
        </section>
      )}
      {trackExercises.length > 0 && (
        <section>
          <div class="flex items-center gap-3 mb-4">
            <span class="eyebrow">exercises — luyện tập</span>
            <span class="flex-1 h-px bg-stone-200 dark:bg-stone-800"></span>
          </div>
          <ul class="grid sm:grid-cols-2 gap-2">
            {trackExercises.map((ex: any) => (
              <a href={`/exercises/${ex.id}`} class="flex items-center gap-2.5 rounded-lg bg-white dark:bg-stone-900 ring-1 ring-stone-200 dark:ring-stone-800 px-4 py-2.5 hover:ring-brand/50 hover:-translate-y-px transition-all duration-200 text-sm text-stone-700 dark:text-stone-300">
                <span class="w-1.5 h-1.5 rounded-full shrink-0" style={`background:${typeColor('exercise')}`}></span>{ex.data.title}
              </a>
            ))}
          </ul>
        </section>
      )}
    </div>
  )}
  {d.type === 'concept' && d.aliases?.length > 0 && (
    <div class="anim mt-10 flex flex-wrap gap-2 text-xs items-center">
      <span class="font-read italic text-stone-400">còn gọi là</span>
      {d.aliases.map((a: string) => <span class="px-2.5 py-1 rounded-md bg-stone-100 dark:bg-stone-900 text-stone-500 dark:text-stone-400">{a}</span>)}
    </div>
  )}
  {usedInLinks.length > 0 && (
    <div class="anim mt-12">
      <div class="flex items-center gap-3 mb-4">
        <span class="eyebrow">xuất hiện trong</span>
        <span class="flex-1 h-px bg-stone-200 dark:bg-stone-800"></span>
      </div>
      <div class="flex flex-wrap gap-2 text-sm">
        {usedInLinks.map((link) => (
          <a href={`/${link.type}/${link.slug}`}
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white dark:bg-stone-900 ring-1 ring-stone-200 dark:ring-stone-800 hover:ring-brand/60 hover:-translate-y-px transition-all duration-200 text-stone-700 dark:text-stone-300">
            <span class="w-1.5 h-1.5 rounded-full" style={`background:${typeColor(link.dataType)}`}></span>{link.title}
          </a>
        ))}
      </div>
    </div>
  )}
  {related.length > 0 && <div class="anim"><RelatedLinks ids={related} title="Liên quan" /></div>}
  {(prevLesson || nextLesson) && (
    <nav class="anim mt-14 grid grid-cols-2 gap-3" aria-label="Bài trước / bài tiếp">
      {prevLesson ? (
        <a href={`/lessons/${prevLesson.id}`} class="group rounded-xl bg-white dark:bg-stone-900 ring-1 ring-stone-200 dark:ring-stone-800 p-4 hover:ring-brand/50 hover:-translate-y-0.5 transition-all duration-200">
          <div class="text-[11px] uppercase tracking-[0.08em] text-stone-400">← Bài trước</div>
          <div class="mt-1.5 text-sm font-medium text-stone-800 dark:text-stone-200 group-hover:text-brand transition-colors">{prevLesson.data.title}</div>
        </a>
      ) : <span></span>}
      {nextLesson ? (
        <a href={`/lessons/${nextLesson.id}`} class="group rounded-xl bg-white dark:bg-stone-900 ring-1 ring-stone-200 dark:ring-stone-800 p-4 hover:ring-brand/50 hover:-translate-y-0.5 transition-all duration-200 text-right">
          <div class="text-[11px] uppercase tracking-[0.08em] text-stone-400">Bài tiếp →</div>
          <div class="mt-1.5 text-sm font-medium text-stone-800 dark:text-stone-200 group-hover:text-brand transition-colors">{nextLesson.data.title}</div>
        </a>
      ) : <span></span>}
    </nav>
  )}
</ReadingLayout>
