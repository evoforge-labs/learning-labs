---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import ReadingLayout from '../../components/layout/ReadingLayout.astro';
import MetaBadges from '../../components/content/MetaBadges.astro';
import RelatedLinks from '../../components/content/RelatedLinks.astro';
import Callout from '../../components/content/Callout.astro';
import Mermaid from '../../components/content/Mermaid.astro';
import Ask from '../../components/content/Ask.astro';
import Answer from '../../components/content/Answer.astro';
import Explain from '../../components/content/Explain.astro';
import { COLLECTION_TYPES, typeColor, trackColor } from '../../lib/types';
import { getAll, usedIn } from '../../lib/content';

export const getStaticPaths = (async () => {
  const paths = [];
  for (const type of COLLECTION_TYPES) {
    const entries = await getAll(type as any) as any[];
    for (const entry of entries) paths.push({ params: { type, slug: entry.id }, props: { entry } });
  }
  return paths;
}) satisfies GetStaticPaths;

const { entry } = Astro.props as { entry: any };
const d = entry.data;
const { Content, headings } = await render(entry);
const components = { Callout, Mermaid, Ask, Answer, Explain };

const kicker = d.type === 'session' ? `Session · ${d.exercise}` :
  d.module ? `${d.module}` : d.skill ? `${d.skill}` : d.type;
const trackLabel = d.track;
const related = [...(d.prerequisites ?? []), ...(d.related ?? [])];
const usedInLinks = d.type === 'concept' ? await usedIn(d.id) : [];

// For a track page, gather its lessons + exercises so the page isn't a dead end.
const byId = (a: any, b: any) => String(a.data.id).localeCompare(String(b.data.id));
const trackLessons = d.type === 'track'
  ? (await getAll('lessons') as any[]).filter((x) => x.data.track === entry.id).sort(byId) : [];
const trackExercises = d.type === 'track'
  ? (await getAll('exercises') as any[]).filter((x) => x.data.track === entry.id).sort(byId) : [];

// Prev/next within a track so lessons read as a continuous course (easy -> expert).
let prevLesson: any = null, nextLesson: any = null;
if (d.type === 'lesson') {
  const sibs = (await getAll('lessons') as any[]).filter((x) => x.data.track === d.track).sort(byId);
  const i = sibs.findIndex((x) => x.data.id === d.id);
  if (i > 0) prevLesson = sibs[i - 1];
  if (i >= 0 && i < sibs.length - 1) nextLesson = sibs[i + 1];
}
---
<ReadingLayout title={d.title} kicker={kicker} trackLabel={trackLabel}
  headings={headings.filter((h: any) => h.depth === 2).map((h: any) => ({ text: h.text, slug: h.slug }))}>
  {d.type === 'track' && (
    <div class="anim mt-4 flex items-center gap-2.5">
      <span class="inline-block h-5 w-1.5 rounded-full" style={`background:${trackColor(entry.id)}`}></span>
      <span class="text-[11px] font-medium uppercase tracking-wider" style={`color:${trackColor(entry.id)}`}>Track</span>
    </div>
  )}
  <div class="anim mt-6">
    <MetaBadges type={d.type} status={d.status} level={d.level} minutes={d.estimatedMinutes} reviewedBy={d.reviewedBy} score={d.score} />
  </div>
  <hr class="anim my-8 border-zinc-200 dark:border-zinc-800" />
  <div class="anim read-body text-zinc-700 dark:text-zinc-300 prose dark:prose-invert max-w-none prose-headings:font-read">
    <Content components={components} />
  </div>
  {d.type === 'track' && (trackLessons.length > 0 || trackExercises.length > 0) && (
    <div class="anim mt-12 space-y-8">
      {trackLessons.length > 0 && (
        <section>
          <div class="text-[11px] uppercase tracking-wider text-zinc-400 mb-3">Lessons · học theo thứ tự</div>
          <div class="grid sm:grid-cols-2 gap-2">
            {trackLessons.map((l: any) => (
              <a href={`/lessons/${l.id}`} class="flex items-center gap-2.5 rounded-lg border border-zinc-200 dark:border-zinc-800 px-4 py-2.5 hover:border-brand/50 text-sm">
                <span class="w-2 h-2 rounded-full shrink-0" style={`background:${typeColor('lesson')}`}></span>{l.data.title}
              </a>
            ))}
          </div>
        </section>
      )}
      {trackExercises.length > 0 && (
        <section>
          <div class="text-[11px] uppercase tracking-wider text-zinc-400 mb-3">Exercises · luyện tập</div>
          <div class="grid sm:grid-cols-2 gap-2">
            {trackExercises.map((ex: any) => (
              <a href={`/exercises/${ex.id}`} class="flex items-center gap-2.5 rounded-lg border border-zinc-200 dark:border-zinc-800 px-4 py-2.5 hover:border-brand/50 text-sm">
                <span class="w-2 h-2 rounded-full shrink-0" style={`background:${typeColor('exercise')}`}></span>{ex.data.title}
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  )}
  {d.type === 'concept' && d.aliases?.length > 0 && (
    <div class="anim mt-8 flex flex-wrap gap-2 text-xs items-center"><span class="text-zinc-400">aka:</span>
      {d.aliases.map((a: string) => <span class="px-2 py-0.5 rounded-full border border-zinc-200 dark:border-zinc-700 text-zinc-500">{a}</span>)}
    </div>
  )}
  {usedInLinks.length > 0 && (
    <div class="anim mt-12 rounded-xl border border-zinc-200 dark:border-zinc-800 p-5">
      <div class="text-[11px] uppercase tracking-wider text-zinc-400 mb-3">Used in</div>
      <div class="flex flex-wrap gap-2 text-sm">
        {usedInLinks.map((link) => (
          <a href={`/${link.type}/${link.slug}`} class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-800 hover:border-brand/50">
            <span class="w-2 h-2 rounded-full" style={`background:${typeColor(link.dataType)}`}></span>{link.title}
          </a>
        ))}
      </div>
    </div>
  )}
  {related.length > 0 && <div class="anim"><RelatedLinks ids={related} title="Related · từ frontmatter" /></div>}
  {(prevLesson || nextLesson) && (
    <nav class="anim mt-12 grid grid-cols-2 gap-3">
      {prevLesson ? (
        <a href={`/lessons/${prevLesson.id}`} class="rounded-xl border border-zinc-200 dark:border-zinc-800 p-4 hover:border-brand/50">
          <div class="text-[11px] uppercase tracking-wider text-zinc-400">← Bài trước</div>
          <div class="mt-1 text-sm font-medium text-zinc-800 dark:text-zinc-200">{prevLesson.data.title}</div>
        </a>
      ) : <span></span>}
      {nextLesson ? (
        <a href={`/lessons/${nextLesson.id}`} class="rounded-xl border border-zinc-200 dark:border-zinc-800 p-4 hover:border-brand/50 text-right">
          <div class="text-[11px] uppercase tracking-wider text-zinc-400">Bài tiếp →</div>
          <div class="mt-1 text-sm font-medium text-zinc-800 dark:text-zinc-200">{nextLesson.data.title}</div>
        </a>
      ) : <span></span>}
    </nav>
  )}
</ReadingLayout>
