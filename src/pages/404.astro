---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { Compass, Search } from '@lucide/astro';
---
<BaseLayout title="Không tìm thấy trang" description="Trang này không tồn tại trong Learning Lab.">
  <main id="main" class="max-w-2xl mx-auto px-4 sm:px-6 py-24 sm:py-32 text-center">
    <p class="anim font-read italic text-7xl sm:text-8xl text-stone-200 dark:text-stone-800 select-none">404</p>
    <h1 class="anim mt-4 font-read font-extrabold text-3xl sm:text-4xl tracking-[-0.02em] text-stone-900 dark:text-stone-100">Trang này chưa được viết.</h1>
    <p class="anim mt-4 text-stone-500 dark:text-stone-400 leading-relaxed max-w-md mx-auto">
      Có thể tài liệu đã đổi đường dẫn, hoặc AI chưa ghi nó vào repo.
      Thử tìm trong thư viện xem.
    </p>
    <div class="anim mt-8 flex justify-center gap-3">
      <Button href="/"><Compass class="w-4 h-4" />Về trang chủ</Button>
      <Button href="/search" variant="outline"><Search class="w-4 h-4" />Tìm kiếm</Button>
    </div>
  </main>
</BaseLayout>
