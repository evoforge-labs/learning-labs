---
import BaseLayout from '../components/layout/BaseLayout.astro';
// Pagefind only generates /pagefind/* during `astro build` (+ pagefind step).
// In `astro dev` those files don't exist, so importing the CSS hard-crashes the
// page. Only wire up Pagefind for production builds; show a hint in dev.
const isProd = import.meta.env.PROD;
---
<BaseLayout title="Search">
  <main class="max-w-3xl mx-auto px-4 py-10">
    <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-white mb-6">Search</h1>
    {isProd ? (
      <div id="search"></div>
    ) : (
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        Tìm kiếm chỉ khả dụng sau khi <code class="font-mono">pnpm build</code> (Pagefind index được sinh lúc build).
      </p>
    )}
  </main>
  {isProd && <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />}
  {isProd && (
    <script>
      document.addEventListener('astro:page-load', async () => {
        // @ts-ignore - served from /pagefind after build
        await import('/pagefind/pagefind-ui.js');
        // @ts-ignore
        new PagefindUI({ element: '#search', showSubResults: true });
      });
    </script>
  )}
</BaseLayout>
