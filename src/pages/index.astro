---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { Compass, GitFork, BookOpen, GraduationCap, Dumbbell, MessageSquareText, ClipboardCheck, LayoutTemplate, ArrowUpRight } from '@lucide/astro';
import { getAll } from '../lib/content';
import { trackColor, typeColor } from '../lib/types';

const [tracks, allConcepts, allLessons, allExercises, allSessions, allRubrics, allTemplates] = await Promise.all([
  getAll('tracks'), getAll('concepts'), getAll('lessons'), getAll('exercises'),
  getAll('sessions'), getAll('rubrics'), getAll('templates'),
]);

// Concepts aren't tagged with a track directly — a track "covers" a concept when
// one of its lessons/exercises references that concept id in prerequisites/related.
const conceptRefs = (x: any): string[] =>
  [...(x.data.prerequisites ?? []), ...(x.data.related ?? [])].filter((id: string) => id.startsWith('concept-'));
const counts = (track: string) => {
  const lessons = allLessons.filter((x: any) => x.data.track === track);
  const exercises = allExercises.filter((x: any) => x.data.track === track);
  const concepts = new Set([...lessons, ...exercises].flatMap(conceptRefs));
  return { lessons: lessons.length, exercises: exercises.length, concepts: concepts.size };
};
const trackIndex = tracks
  .map((t: any) => ({ t, c: counts(t.id) }))
  .sort((a: any, b: any) => a.t.data.title.localeCompare(b.t.data.title, 'en'));

const recentSessions = (allSessions as any[])
  .filter((s) => s.data.date)
  .sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date))
  .slice(0, 5);
const fmtDate = (d: Date) => new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(d);

const library = [
  { href: '/concepts', label: 'Concepts', count: allConcepts.length, Icon: BookOpen, color: typeColor('concept') },
  { href: '/lessons', label: 'Lessons', count: allLessons.length, Icon: GraduationCap, color: typeColor('lesson') },
  { href: '/exercises', label: 'Exercises', count: allExercises.length, Icon: Dumbbell, color: typeColor('exercise') },
  { href: '/sessions', label: 'Sessions', count: allSessions.length, Icon: MessageSquareText, color: typeColor('session') },
  { href: '/rubrics', label: 'Rubrics', count: allRubrics.length, Icon: ClipboardCheck, color: typeColor('rubric') },
  { href: '/templates', label: 'Templates', count: allTemplates.length, Icon: LayoutTemplate, color: typeColor('template') },
];
const totalDocs = tracks.length + allConcepts.length + allLessons.length + allExercises.length + allSessions.length + allRubrics.length + allTemplates.length;
---
<BaseLayout title="Home">
  <main id="main" class="max-w-6xl mx-auto px-4 sm:px-6">

    <!-- hero -->
    <section class="pt-14 sm:pt-20 pb-12 sm:pb-16 max-w-3xl">
      <p class="anim eyebrow mb-4">nhật ký học tập cá nhân</p>
      <h1 class="anim font-read font-extrabold text-[2.6rem] sm:text-[3.6rem] leading-[1.05] tracking-[-0.02em] text-stone-900 dark:text-stone-100">
        Thư viện của những điều <em class="text-brand not-italic font-read italic">bạn đã học</em>.
      </h1>
      <p class="anim mt-5 text-lg text-stone-500 dark:text-stone-400 leading-relaxed max-w-xl">
        AI hỏi, bạn trả lời, AI chấm và ghi lại. Lộ trình, khái niệm, bài luyện tập
        và lịch sử session — tất cả sống trong một repo MDX, web này chỉ để đọc lại.
      </p>
      <div class="anim mt-7 flex flex-wrap gap-3">
        <Button href="/tracks"><Compass class="w-4 h-4" />Xem các track</Button>
        <Button href="/knowledge-map" variant="outline"><GitFork class="w-4 h-4" />Knowledge map</Button>
      </div>
      <dl class="anim mt-10 flex flex-wrap gap-x-8 gap-y-3 text-sm text-stone-500 dark:text-stone-400">
        <div class="flex items-baseline gap-1.5"><dt class="font-read font-bold text-2xl text-stone-900 dark:text-stone-100 tabular-nums">{tracks.length}</dt><dd>tracks</dd></div>
        <div class="flex items-baseline gap-1.5"><dt class="font-read font-bold text-2xl text-stone-900 dark:text-stone-100 tabular-nums">{allConcepts.length}</dt><dd>concepts</dd></div>
        <div class="flex items-baseline gap-1.5"><dt class="font-read font-bold text-2xl text-stone-900 dark:text-stone-100 tabular-nums">{allExercises.length}</dt><dd>exercises</dd></div>
        <div class="flex items-baseline gap-1.5"><dt class="font-read font-bold text-2xl text-stone-900 dark:text-stone-100 tabular-nums">{totalDocs}</dt><dd>tài liệu</dd></div>
      </dl>
    </section>

    <!-- tracks: numbered editorial index -->
    <section class="pb-16">
      <div class="anim flex items-center gap-4 mb-6">
        <span class="eyebrow">các track</span>
        <span class="flex-1 h-px bg-stone-200 dark:bg-stone-800"></span>
        <a href="/tracks" class="text-xs text-brand hover:underline underline-offset-4 shrink-0">Xem tất cả</a>
      </div>
      <ol class="grid lg:grid-cols-2 gap-x-12">
        {trackIndex.map(({ t, c }: any, i: number) => (
          <li class="anim">
            <a href={`/tracks/${t.id}`}
              class="group flex gap-4 py-5 border-b border-stone-200/80 dark:border-stone-800/80 hover:bg-stone-100/60 dark:hover:bg-stone-900/60 hover:border-transparent rounded-lg hover:px-4 -mx-0 transition-all duration-200">
              <span class="font-read italic text-lg text-stone-300 dark:text-stone-600 tabular-nums w-8 shrink-0 pt-0.5">{String(i + 1).padStart(2, '0')}</span>
              <span class="flex-1 min-w-0">
                <span class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full shrink-0" style={`background:${trackColor(t.id)}`}></span>
                  <span class="font-semibold text-stone-900 dark:text-stone-100 group-hover:text-brand transition-colors">{t.data.title}</span>
                </span>
                {t.data.summary && <span class="block mt-1 text-sm text-stone-500 dark:text-stone-400 line-clamp-2">{t.data.summary}</span>}
                <span class="block mt-2 text-xs text-stone-400 dark:text-stone-500 tabular-nums">{c.concepts} concepts · {c.lessons} lessons · {c.exercises} exercises</span>
              </span>
              <ArrowUpRight class="w-4 h-4 shrink-0 mt-1 text-stone-300 dark:text-stone-600 group-hover:text-brand group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" />
            </a>
          </li>
        ))}
      </ol>
    </section>

    <!-- sessions + library -->
    <section class="grid lg:grid-cols-5 gap-12 pb-8">
      <div class="lg:col-span-3">
        <div class="anim flex items-center gap-4 mb-6">
          <span class="eyebrow">sessions gần đây</span>
          <span class="flex-1 h-px bg-stone-200 dark:bg-stone-800"></span>
        </div>
        {recentSessions.length > 0 ? (
          <ul class="anim space-y-1">
            {recentSessions.map((s: any) => (
              <li>
                <a href={`/sessions/${s.id}`} class="group flex items-center gap-4 px-4 py-3 rounded-lg hover:bg-stone-100/60 dark:hover:bg-stone-900/60 transition-colors">
                  <span class="w-1.5 h-1.5 rounded-full shrink-0" style={`background:${typeColor('session')}`}></span>
                  <span class="flex-1 min-w-0 text-sm text-stone-700 dark:text-stone-300 group-hover:text-brand truncate transition-colors">{s.data.title}</span>
                  {typeof s.data.score === 'number' && <span class="text-xs font-semibold tabular-nums text-emerald-700 dark:text-emerald-400">{s.data.score}/100</span>}
                  <time class="text-xs text-stone-400 tabular-nums shrink-0">{fmtDate(s.data.date)}</time>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="anim rounded-xl border border-dashed border-stone-300 dark:border-stone-700 px-6 py-10 text-center">
            <MessageSquareText class="w-6 h-6 mx-auto text-stone-400" />
            <p class="mt-3 text-sm text-stone-500 dark:text-stone-400 max-w-sm mx-auto leading-relaxed">
              Chưa có session nào. Khi bạn luyện tập cùng AI coach, mỗi buổi hỏi–đáp
              sẽ được ghi lại ở đây kèm điểm số.
            </p>
            <a href="/exercises" class="mt-4 inline-block text-sm text-brand hover:underline underline-offset-4">Xem bài luyện tập →</a>
          </div>
        )}
      </div>
      <div class="lg:col-span-2">
        <div class="anim flex items-center gap-4 mb-6">
          <span class="eyebrow">thư viện</span>
          <span class="flex-1 h-px bg-stone-200 dark:bg-stone-800"></span>
        </div>
        <ul class="anim grid grid-cols-2 gap-2">
          {library.map(({ href, label, count, Icon, color }) => (
            <li>
              <a href={href} class="group flex items-center gap-3 px-4 py-3.5 rounded-xl bg-white dark:bg-stone-900 ring-1 ring-stone-200 dark:ring-stone-800 hover:ring-brand/50 hover:-translate-y-0.5 transition-all duration-200">
                <Icon class="w-4 h-4 shrink-0" style={`color:${color}`} />
                <span class="flex-1 text-sm text-stone-700 dark:text-stone-300 group-hover:text-brand transition-colors">{label}</span>
                <span class="text-xs text-stone-400 tabular-nums">{count}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>
