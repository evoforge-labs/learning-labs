---
import { User } from '@lucide/astro';
import { typeColor } from '../../lib/types';
const c = typeColor('session');
---
<div class="my-6 not-prose sm:pl-8">
  <div class="flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-stone-400 dark:text-stone-500 mb-2"><User class="w-4 h-4" style={`color:${c}`} />Bạn trả lời</div>
  <div class="read-body !text-[18px] rounded-xl rounded-tr-sm border-l-[3px] px-5 py-4 text-stone-700 dark:text-stone-300"
    style={`border-color:${c};background:color-mix(in srgb,${c} 6%,transparent)`}><slot /></div>
</div>
