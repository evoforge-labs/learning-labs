---
import Badge from '../ui/Badge.astro';
import { Clock, Gauge } from '@lucide/astro';
interface Props { type: string; status?: string; level?: string; minutes?: number; reviewedBy?: string | null; score?: number | null; hideType?: boolean; }
const { type, status, level, minutes, reviewedBy, score, hideType = false } = Astro.props;
---
<div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-stone-500 dark:text-stone-400">
  {!hideType && <Badge type={type} />}
  {status && <Badge status={status} />}
  {level && <span class="inline-flex items-center gap-1"><Gauge class="w-3.5 h-3.5" />{level}</span>}
  {minutes && <span class="inline-flex items-center gap-1 tabular-nums"><Clock class="w-3.5 h-3.5" />{minutes} phút</span>}
  {reviewedBy && <span class="font-read italic">reviewed by {reviewedBy}</span>}
  {typeof score === 'number' && (
    <span class="inline-flex items-center gap-1 px-2 py-[3px] rounded-md bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 font-semibold tabular-nums">{score} / 100</span>
  )}
</div>
