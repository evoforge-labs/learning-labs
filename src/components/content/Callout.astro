---
import { Lightbulb, Info, TriangleAlert } from '@lucide/astro';
interface Props { title?: string; type?: 'tip' | 'note' | 'warning'; }
const { type = 'tip', title } = Astro.props;
const defaultTitle = type === 'tip' ? 'Tip' : type === 'note' ? 'Note' : 'Warning';
const label = title ?? defaultTitle;
const styles = {
  tip:     { border: 'border-brand', bg: 'bg-brand/5', text: 'text-brand', color: 'var(--color-brand)' },
  note:    { border: 'border-[#3b82f6]', bg: 'bg-[#3b82f6]/5', text: 'text-[#3b82f6]', color: '#3b82f6' },
  warning: { border: 'border-[#f59e0b]', bg: 'bg-[#f59e0b]/5', text: 'text-[#f59e0b]', color: '#f59e0b' },
};
const s = styles[type];
---
<div class={`not-prose my-7 rounded-lg border-l-[3px] ${s.border} ${s.bg} px-5 py-4 read-body !text-[17px]`}>
  <div class={`font-semibold ${s.text} mb-1 font-sans text-sm flex items-center gap-1.5`}>
    {type === 'tip' && <Lightbulb class="w-4 h-4" />}
    {type === 'note' && <Info class="w-4 h-4" />}
    {type === 'warning' && <TriangleAlert class="w-4 h-4" />}
    {label}
  </div>
  <slot />
</div>
