---
import { Lightbulb, Info, TriangleAlert } from '@lucide/astro';
interface Props { title?: string; type?: 'tip' | 'note' | 'warning'; }
const { type = 'tip', title } = Astro.props;
const defaultTitle = type === 'tip' ? 'Tip' : type === 'note' ? 'Note' : 'Warning';
const label = title ?? defaultTitle;
const styles = {
  tip:     { color: '#0d9488' },
  note:    { color: '#3b82f6' },
  warning: { color: '#f59e0b' },
};
const c = styles[type].color;
---
<div class="not-prose my-8 rounded-xl border-l-[3px] px-5 py-4 read-body !text-[17px] text-stone-700 dark:text-stone-300"
  style={`border-color:${c};background:color-mix(in srgb,${c} 5%,transparent)`}>
  <div class="font-sans font-semibold text-sm mb-1 flex items-center gap-1.5" style={`color:${c}`}>
    {type === 'tip' && <Lightbulb class="w-4 h-4" />}
    {type === 'note' && <Info class="w-4 h-4" />}
    {type === 'warning' && <TriangleAlert class="w-4 h-4" />}
    {label}
  </div>
  <slot />
</div>
