---
import type { GraphNode, GraphEdge } from '../../lib/types';
import { TYPE_COLOR, TRACK_COLOR, TYPE_LABEL } from '../../lib/types';
interface Props { nodes: GraphNode[]; edges: GraphEdge[]; }
const { nodes, edges } = Astro.props;

// Per-type counts for the legend (server-side, from the nodes we already have).
const typeOrder = ['concept', 'lesson', 'exercise', 'track', 'rubric', 'session', 'template'];
const counts: Record<string, number> = {};
for (const n of nodes) counts[n.type] = (counts[n.type] ?? 0) + 1;
const legend = typeOrder.filter((t) => counts[t]).map((t) => ({ type: t, label: TYPE_LABEL[t] ?? t, hex: TYPE_COLOR[t] ?? '#888', count: counts[t] }));

// TYPE_COLOR/TRACK_COLOR are raw hex on purpose: the cytoscape canvas can't
// resolve CSS custom properties.
const payload = JSON.stringify({ nodes, edges, typeColors: TYPE_COLOR, trackColors: TRACK_COLOR });
---
<!-- Graph fills the full width; all controls float on top of it. -->
<div class="km-graph relative w-full h-[78dvh] rounded-xl ring-1 ring-stone-200 dark:ring-stone-800 bg-white dark:bg-stone-900 overflow-hidden">
  <div id="cy" class="w-full h-full"></div>

  <!-- floating control panel (top-left) -->
  <div id="km-panel" class="absolute z-10 top-3 left-3 w-52 max-w-[70%] rounded-xl border border-stone-200/80 dark:border-stone-700/80 bg-white/85 dark:bg-stone-900/85 backdrop-blur-md shadow-lg">
    <button id="km-panel-toggle" class="flex w-full items-center justify-between px-3 py-2 text-sm font-medium text-stone-700 dark:text-stone-200">
      <span class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
        Bộ lọc
      </span>
      <svg class="km-chevron w-4 h-4 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
    </button>

    <div class="km-panel-body px-2.5 pb-2.5 space-y-2.5">
      <input id="km-search" type="search" placeholder="Tìm node…" autocomplete="off"
        class="w-full rounded-lg border border-stone-200 dark:border-stone-700 bg-white dark:bg-stone-800 px-2.5 py-1.5 text-sm focus:outline-none focus:border-brand/60" />

      <div class="flex items-center gap-1.5">
        <label class="flex flex-1 items-center gap-1.5 text-xs text-stone-500">
          Màu:
          <select id="km-colorby" class="flex-1 rounded-lg border border-stone-200 dark:border-stone-700 bg-white dark:bg-stone-800 px-1.5 py-1 text-sm">
            <option value="type">Type</option>
            <option value="track">Track</option>
          </select>
        </label>
        <button id="km-reset" title="Reset view" class="rounded-lg border border-stone-200 dark:border-stone-700 bg-white dark:bg-stone-800 px-2 py-1 text-sm hover:border-brand/60">⟳</button>
      </div>

      <div class="border-t border-stone-200/70 dark:border-stone-700/70 pt-2">
        <div class="text-[10px] uppercase tracking-wider text-stone-400 mb-1.5">Legend · click để lọc</div>
        <div id="km-legend" class="space-y-1 max-h-56 overflow-y-auto">
          {legend.map((l) => (
            <button class="km-legend-item flex w-full items-center gap-2 rounded-md px-1.5 py-1 text-sm transition hover:bg-stone-100 dark:hover:bg-stone-800" data-type={l.type}>
              <span class="w-2.5 h-2.5 rounded-full shrink-0" style={`background:${l.hex}`}></span>
              <span class="flex-1 text-left">{l.label}</span>
              <span class="text-xs text-stone-400 tabular-nums">{l.count}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- peek panel (top-right) -->
  <div id="km-peek" class="hidden absolute z-10 right-3 top-3 w-64 max-w-[70%] rounded-xl border border-stone-200 dark:border-stone-800 bg-white/95 dark:bg-stone-900/95 backdrop-blur-md shadow-lg p-4">
    <button id="km-peek-close" class="absolute right-2 top-2 text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 text-sm leading-none">✕</button>
    <div class="flex items-center gap-2 mb-1.5">
      <span id="km-peek-dot" class="w-2 h-2 rounded-full shrink-0"></span>
      <span id="km-peek-type" class="text-[11px] uppercase tracking-wider text-stone-400"></span>
    </div>
    <h3 id="km-peek-title" class="font-semibold text-sm text-stone-900 dark:text-white"></h3>
    <p id="km-peek-summary" class="mt-1.5 text-xs text-stone-500 dark:text-stone-400 line-clamp-4"></p>
    <a id="km-peek-link" href="#" class="mt-3 inline-block rounded-lg bg-brand px-3 py-1.5 text-xs font-medium text-white dark:text-stone-950 hover:brightness-110 transition active:scale-95">Mở trang →</a>
  </div>
</div>

<style>
  /* collapsed: hide everything but the toggle button; rotate the chevron. */
  #km-panel.km-collapsed .km-panel-body { display: none; }
  #km-panel.km-collapsed .km-chevron { transform: rotate(-90deg); }
  #km-panel.km-collapsed { width: auto; }
</style>

<script type="application/json" id="cy-data" set:html={payload}></script>
<script>
  import cytoscape from 'cytoscape';
  import cola from 'cytoscape-cola';
  cytoscape.use(cola);

  let running: any = null;       // stop the physics sim when leaving the page
  let cy: any = null;
  let selectedNode: any = null;  // node whose peek panel is open (persistent highlight)
  const hiddenTypes = new Set<string>();

  function renderGraph() {
    const el = document.getElementById('cy');
    const dataEl = document.getElementById('cy-data');
    if (!el || !dataEl) return;  // not on this page
    const { nodes, edges, typeColors, trackColors } = JSON.parse(dataEl.textContent || '{}');

    cy = cytoscape({
      container: el,
      elements: [
        ...nodes.map((n: any) => ({ data: {
          id: n.id, label: n.label, url: n.url, type: n.type,
          summary: n.summary || '', title: n.label,
          colorType: typeColors[n.type] || '#888',
          colorTrack: (n.track && trackColors[n.track]) || '#a8a29e',
        } })),
        ...edges.map((e: any, i: number) => ({ data: { id: `e${i}`, source: e.source, target: e.target } })),
      ],
      style: [
        { selector: 'node', style: { 'background-color': 'data(colorType)', label: 'data(label)', color: '#a8a29e', 'font-size': 10, 'text-valign': 'bottom', 'text-margin-y': 4, 'transition-property': 'opacity', 'transition-duration': 150 } },
        { selector: 'edge', style: { width: 1.5, 'line-color': '#a8a29e66', 'curve-style': 'bezier', 'transition-property': 'opacity', 'transition-duration': 150 } },
        { selector: '.faded', style: { opacity: 0.12 } },
        { selector: 'edge.faded', style: { opacity: 0.05 } },
        { selector: '.km-hidden', style: { display: 'none' } },
        // search match + selected node share the same ring
        { selector: 'node.match, node.km-selected', style: { 'border-width': 3, 'border-color': '#14b8a6' } },
      ],
    });

    // Continuous physics: nodes keep gently settling and dragging one perturbs
    // its neighbours live (the "bouncing" feel). Filtering hides nodes via
    // display:none — they stay in the simulation, so the layout never jumps.
    // Larger edgeLength + nodeSpacing spread the graph out so it reads clearly.
    // The sim is stopped on page-leave (astro:before-swap) to free CPU.
    const layout = cy.layout({ name: 'cola', infinite: true, fit: false, avoidOverlap: true, handleDisconnected: true, nodeSpacing: 28, edgeLength: 150 } as any);
    layout.run();
    running = layout;
    // The container is absolutely positioned, so its height can resolve a frame
    // after cytoscape inits — resize() before fitting so it doesn't lock to 0.
    setTimeout(() => { cy.resize(); cy.animate({ fit: { eles: cy.elements(), padding: 50 }, duration: 400 }); }, 600);

    wireControls();
  }

  function wireControls() {
    // hover highlight (temporary) — restores the selected node's highlight on out
    cy.on('mouseover', 'node', (evt: any) => fadeExcept(evt.target));
    cy.on('mouseout', 'node', () => {
      if (selectedNode) fadeExcept(selectedNode);
      else cy.elements().removeClass('faded');
    });

    // click node -> keep it selected (persistent neighborhood highlight) + peek panel
    cy.on('tap', 'node', (evt: any) => {
      selectedNode = evt.target;
      cy.nodes().removeClass('km-selected');
      selectedNode.addClass('km-selected');
      fadeExcept(selectedNode);
      showPeek(selectedNode.data());
    });
    cy.on('tap', (evt: any) => { if (evt.target === cy) hidePeek(); });

    // legend = filter
    document.querySelectorAll('.km-legend-item').forEach((btn) => {
      btn.addEventListener('click', () => {
        const t = (btn as HTMLElement).dataset.type!;
        if (hiddenTypes.has(t)) { hiddenTypes.delete(t); btn.classList.remove('opacity-40'); }
        else { hiddenTypes.add(t); btn.classList.add('opacity-40'); }
        applyFilter();
      });
    });

    // color-by toggle
    const colorby = document.getElementById('km-colorby') as HTMLSelectElement;
    colorby?.addEventListener('change', () => {
      const key = colorby.value === 'track' ? 'data(colorTrack)' : 'data(colorType)';
      cy.style().selector('node').style('background-color', key).update();
    });

    // search: highlight matches; Enter centers on first match
    const search = document.getElementById('km-search') as HTMLInputElement;
    search?.addEventListener('input', () => {
      const q = search.value.trim().toLowerCase();
      cy.nodes().removeClass('match');
      if (!q) { cy.elements().removeClass('faded'); return; }
      const matches = cy.nodes().filter((n: any) => n.data('label')?.toLowerCase().includes(q));
      cy.elements().addClass('faded');
      matches.removeClass('faded').addClass('match');
      matches.connectedEdges().removeClass('faded');
    });
    search?.addEventListener('keydown', (e: any) => {
      if (e.key !== 'Enter') return;
      const q = search.value.trim().toLowerCase();
      const first = cy.nodes().filter((n: any) => n.data('label')?.toLowerCase().includes(q))[0];
      if (first) cy.animate({ center: { eles: first }, zoom: 1.6, duration: 350 });
    });

    document.getElementById('km-reset')?.addEventListener('click', () => {
      cy.animate({ fit: { eles: cy.elements(':visible'), padding: 50 }, duration: 350 });
    });

    document.getElementById('km-peek-close')?.addEventListener('click', hidePeek);

    // collapsible control panel — collapsed by default on small screens.
    const panel = document.getElementById('km-panel');
    const toggle = document.getElementById('km-panel-toggle');
    if (panel && window.matchMedia('(max-width: 767px)').matches) panel.classList.add('km-collapsed');
    toggle?.addEventListener('click', () => panel?.classList.toggle('km-collapsed'));
  }

  // Fade everything except the given node and its closed neighbourhood.
  function fadeExcept(node: any) {
    cy.elements().addClass('faded');
    node.closedNeighborhood().removeClass('faded');
  }

  function applyFilter() {
    cy.batch(() => {
      cy.nodes().forEach((n: any) => {
        if (hiddenTypes.has(n.data('type'))) n.addClass('km-hidden');
        else n.removeClass('km-hidden');
      });
    });
  }

  function showPeek(d: any) {
    const peek = document.getElementById('km-peek'); if (!peek) return;
    const colorby = (document.getElementById('km-colorby') as HTMLSelectElement)?.value;
    (document.getElementById('km-peek-dot') as HTMLElement).style.background = colorby === 'track' ? d.colorTrack : d.colorType;
    (document.getElementById('km-peek-type') as HTMLElement).textContent = d.type || '';
    (document.getElementById('km-peek-title') as HTMLElement).textContent = d.title || d.label || '';
    (document.getElementById('km-peek-summary') as HTMLElement).textContent = d.summary || '';
    (document.getElementById('km-peek-link') as HTMLAnchorElement).href = d.url || '#';
    peek.classList.remove('hidden');
  }
  function hidePeek() {
    document.getElementById('km-peek')?.classList.add('hidden');
    selectedNode = null;
    if (cy) { cy.nodes().removeClass('km-selected'); cy.elements().removeClass('faded'); }
  }

  document.addEventListener('astro:before-swap', () => { running?.stop?.(); running = null; cy = null; });
  document.addEventListener('astro:page-load', renderGraph);
</script>
