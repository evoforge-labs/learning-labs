---
import type { GraphEdge } from '../../lib/types';
import type { PositionedNode } from '../../lib/graph-layout';
interface Props { nodes: PositionedNode[]; edges: GraphEdge[]; }
const { nodes, edges } = Astro.props;

// WebGL needs real hex values (CSS vars don't reach the shaders), so we mirror
// the tokens from global.css here.
const TYPE_HEX: Record<string, string> = { concept: '#3b82f6', lesson: '#22c55e', exercise: '#f59e0b', session: '#8b5cf6', rubric: '#f43f5e', template: '#64748b', track: '#6366f1' };
const TRACK_HEX: Record<string, string> = {
  'ai-engineering': '#6366f1', 'building-with-ai-agents': '#8b5cf6',
  'product-minded-builder': '#14b8a6', 'solo-founder': '#f97316',
  'system-design-for-builders': '#0ea5e9',
};
const TYPE_LABEL: Record<string, string> = { concept: 'Concept', lesson: 'Lesson', exercise: 'Exercise', session: 'Session', rubric: 'Rubric', template: 'Template', track: 'Track' };

// Per-type counts for the legend (server-side, from the nodes we already have).
const typeOrder = ['concept', 'lesson', 'exercise', 'track', 'rubric', 'session', 'template'];
const counts: Record<string, number> = {};
for (const n of nodes) counts[n.type] = (counts[n.type] ?? 0) + 1;
const legend = typeOrder.filter((t) => counts[t]).map((t) => ({ type: t, label: TYPE_LABEL[t] ?? t, hex: TYPE_HEX[t] ?? '#888', count: counts[t] }));

const payload = JSON.stringify({ nodes, edges, typeColors: TYPE_HEX, trackColors: TRACK_HEX });
---
<!-- Graph fills the full width; all controls float on top of it. -->
<div class="km-graph relative w-full h-[78vh] rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 overflow-hidden">
  <div id="cy" class="w-full h-full"></div>

  <!-- floating control panel (top-left) -->
  <div id="km-panel" class="absolute z-10 top-3 left-3 w-52 max-w-[70%] rounded-xl border border-zinc-200/80 dark:border-zinc-700/80 bg-white/85 dark:bg-zinc-900/85 backdrop-blur-md shadow-lg">
    <button id="km-panel-toggle" class="flex w-full items-center justify-between px-3 py-2 text-sm font-medium text-zinc-700 dark:text-zinc-200">
      <span class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
        Bộ lọc
      </span>
      <svg class="km-chevron w-4 h-4 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
    </button>

    <div class="km-panel-body px-2.5 pb-2.5 space-y-2.5">
      <input id="km-search" type="search" placeholder="Tìm node…" autocomplete="off"
        class="w-full rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-2.5 py-1.5 text-sm focus:outline-none focus:border-brand/60" />

      <div class="flex items-center gap-1.5">
        <label class="flex flex-1 items-center gap-1.5 text-xs text-zinc-500">
          Màu:
          <select id="km-colorby" class="flex-1 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-1.5 py-1 text-sm">
            <option value="type">Type</option>
            <option value="track">Track</option>
          </select>
        </label>
        <button id="km-physics" title="Physics: tắt (kéo node vẫn tạm bật)" class="km-toggle rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-2 py-1 text-sm hover:border-brand/60">◉</button>
        <button id="km-reset" title="Reset view" class="rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 px-2 py-1 text-sm hover:border-brand/60">⟳</button>
      </div>

      <div class="border-t border-zinc-200/70 dark:border-zinc-700/70 pt-2">
        <div class="text-[10px] uppercase tracking-wider text-zinc-400 mb-1.5">Legend · click để lọc</div>
        <div id="km-legend" class="space-y-1 max-h-56 overflow-y-auto">
          {legend.map((l) => (
            <button class="km-legend-item flex w-full items-center gap-2 rounded-md px-1.5 py-1 text-sm transition hover:bg-zinc-100 dark:hover:bg-zinc-800" data-type={l.type}>
              <span class="w-2.5 h-2.5 rounded-full shrink-0" style={`background:${l.hex}`}></span>
              <span class="flex-1 text-left">{l.label}</span>
              <span class="text-xs text-zinc-400 tabular-nums">{l.count}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- peek panel (top-right) -->
  <div id="km-peek" class="hidden absolute z-10 right-3 top-3 w-64 max-w-[70%] rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white/95 dark:bg-zinc-900/95 backdrop-blur-md shadow-lg p-4">
    <button id="km-peek-close" class="absolute right-2 top-2 text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 text-sm leading-none">✕</button>
    <div class="flex items-center gap-2 mb-1.5">
      <span id="km-peek-dot" class="w-2 h-2 rounded-full shrink-0"></span>
      <span id="km-peek-type" class="text-[11px] uppercase tracking-wider text-zinc-400"></span>
    </div>
    <h3 id="km-peek-title" class="font-semibold text-sm text-zinc-900 dark:text-white"></h3>
    <p id="km-peek-summary" class="mt-1.5 text-xs text-zinc-500 dark:text-zinc-400 line-clamp-4"></p>
    <a id="km-peek-link" href="#" class="mt-3 inline-block rounded-lg bg-brand px-3 py-1.5 text-xs font-medium text-white hover:opacity-90">Mở trang →</a>
  </div>
</div>

<style>
  /* collapsed: hide everything but the toggle button; rotate the chevron. */
  #km-panel.km-collapsed .km-panel-body { display: none; }
  #km-panel.km-collapsed .km-chevron { transform: rotate(-90deg); }
  #km-panel.km-collapsed { width: auto; }
  /* physics button lit while the simulation is running */
  #km-physics.km-on { border-color: var(--color-brand); color: var(--color-brand); }
</style>

<script type="application/json" id="cy-data" set:html={payload}></script>
<script>
  import Graph from 'graphology';
  import Sigma from 'sigma';
  import forceAtlas2 from 'graphology-layout-forceatlas2';
  import FA2Layout from 'graphology-layout-forceatlas2/worker';
  import { EdgeRectangleProgram } from 'sigma/rendering';

  // ---------------------------------------------------------------------------
  // Why this is smooth, unlike the old cytoscape/cola version:
  //  1. Positions are computed at BUILD time (lib/graph-layout.ts), so the first
  //     frame costs zero layout work.
  //  2. Sigma renders nodes/edges/labels in WebGL — pan/zoom is a camera matrix
  //     change, not a redraw of 3k elements.
  //  3. Physics lives in a web worker and is asleep by default. It wakes only
  //     while you drag a node, or when you flip the physics button on. An idle
  //     map burns 0% CPU.
  //  4. Labels are culled by sigma (labelRenderedSizeThreshold + label grid),
  //     so we never draw 800 overlapping strings.
  // NOTE: never put a `type` attribute on a node — sigma reads that as the node
  // *program* name (circle/image/…). Node kind is stored as `kind`.
  // ---------------------------------------------------------------------------

  // Sigma scales item sizes with zoom, so an edge that reads fine at fit-zoom
  // becomes a fat rope up close. Edges stay thin + low-alpha; only the edges of
  // the node you're pointing at get to be loud (`edgeHi`).
  const THEMES = {
    light: { label: '#27272a', edge: 'rgba(100,116,139,0.30)', edgeHi: 'rgba(51,65,85,0.75)',
             edgeDim: 'rgba(100,116,139,0.05)', dim: '#e7e7ea',
             chipBg: '#ffffff', chipText: '#18181b', chipBorder: 'rgba(0,0,0,0.10)',
             chipShadow: 'rgba(0,0,0,0.18)', ring: 'rgba(99,102,241,0.95)' },
    dark:  { label: '#e4e4e7', edge: 'rgba(113,113,122,0.32)', edgeHi: 'rgba(212,212,216,0.62)',
             edgeDim: 'rgba(113,113,122,0.04)', dim: '#232326',
             chipBg: '#27272a', chipText: '#fafafa', chipBorder: 'rgba(255,255,255,0.14)',
             chipShadow: 'rgba(0,0,0,0.55)', ring: 'rgba(129,140,248,0.95)' },
  };

  /**
   * Sigma's built-in hover renderer hardcodes a `#FFF` label box, so in dark mode
   * it painted near-white text on a white chip — unreadable. This draws the same
   * idea (ring on the node + a label chip beside it) with theme colours.
   */
  function drawHover(context: CanvasRenderingContext2D, data: any, settings: any) {
    const size = settings.labelSize;
    context.font = `${settings.labelWeight} ${size}px ${settings.labelFont}`;

    context.beginPath();
    context.arc(data.x, data.y, data.size + 2.5, 0, Math.PI * 2);
    context.lineWidth = 2;
    context.strokeStyle = pal.ring;
    context.stroke();

    // The canvas label is clipped to keep the map readable; the chip has room
    // for the real title, so show that.
    const label = data.full || (typeof data.label === 'string' ? data.label : '');
    if (!label) return;

    const padX = 7, padY = 5;
    const w = context.measureText(label).width + padX * 2;
    const h = size + padY * 2;
    const x = data.x + data.size + 7;
    const y = data.y - h / 2;

    context.beginPath();
    context.roundRect(x, y, w, h, 5);
    context.shadowOffsetX = 0;
    context.shadowOffsetY = 1;
    context.shadowBlur = 8;
    context.shadowColor = pal.chipShadow;
    context.fillStyle = pal.chipBg;
    context.fill();
    context.shadowBlur = 0;
    context.shadowColor = 'transparent';
    context.lineWidth = 1;
    context.strokeStyle = pal.chipBorder;
    context.stroke();

    context.fillStyle = pal.chipText;
    context.fillText(label, x + padX, data.y + size / 3);
  }

  // Long Vietnamese titles overlap badly as graph labels, so the canvas gets a
  // clipped version and the peek panel keeps the full title.
  const MAX_LABEL = 24;
  const clip = (s: string) => (s && s.length > MAX_LABEL ? s.slice(0, MAX_LABEL - 1).trimEnd() + '…' : s);

  let renderer: any = null;
  let graph: any = null;
  let fa2: any = null;
  let observer: MutationObserver | null = null;
  let sleepTimer: any = null;

  // render state — reducers read these, so mutate then refresh()
  let pal = THEMES.light;
  let colorBy: 'type' | 'track' = 'type';
  let selected: string | null = null;
  let focusNode: string | null = null;       // node being hovered or selected
  let focusSet: Set<string> | null = null;   // focusNode + its neighbours
  let matchSet: Set<string> | null = null;   // search hits
  const hiddenTypes = new Set<string>();
  const hiddenNodes = new Set<string>();     // derived from hiddenTypes, for the edge reducer

  function currentTheme() {
    return document.documentElement.classList.contains('dark') ? THEMES.dark : THEMES.light;
  }

  function renderGraph() {
    const el = document.getElementById('cy');
    const dataEl = document.getElementById('cy-data');
    if (!el || !dataEl) return; // not on this page

    const { nodes, edges, typeColors, trackColors } = JSON.parse(dataEl.textContent || '{}');
    pal = currentTheme();

    graph = new Graph({ type: 'undirected', multi: false, allowSelfLoops: false });
    for (const n of nodes) {
      graph.addNode(n.id, {
        x: n.x, y: n.y,
        // Obsidian-style: well-connected nodes are bigger and get labelled first.
        size: 3.5 + Math.min(Math.sqrt(n.degree || 0) * 2.1, 11),
        label: clip(n.label),
        full: n.label,
        kind: n.type,
        url: n.url,
        summary: n.summary || '',
        colorType: typeColors[n.type] || '#888',
        colorTrack: (n.track && trackColors[n.track]) || '#a1a1aa',
        color: typeColors[n.type] || '#888',
      });
    }
    for (const e of edges) {
      if (e.source === e.target) continue;
      if (graph.hasNode(e.source) && graph.hasNode(e.target)) graph.mergeEdge(e.source, e.target);
    }

    renderer = new Sigma(graph, el as HTMLElement, {
      allowInvalidContainer: true,       // the container height can resolve a frame late
      renderLabels: true,
      labelFont: '"Inter Variable", ui-sans-serif, system-ui, sans-serif',
      labelSize: 12,
      labelWeight: '500',
      labelColor: { color: pal.label },
      defaultDrawNodeHover: drawHover,
      labelRenderedSizeThreshold: 10,    // only labels nodes big enough on screen
      labelDensity: 0.45,
      // The anti-overlap grid keys off node position, but a label extends well
      // past its own cell — so the cell has to be roughly label-width for long
      // titles to stop colliding.
      labelGridCellSize: 200,
      defaultEdgeColor: pal.edge,
      // 'line' (sigma's default) is a gl.LINES hairline — half a CSS pixel on
      // retina, i.e. invisible. Rectangle edges honour `size`.
      defaultEdgeType: 'straight',
      edgeProgramClasses: { straight: EdgeRectangleProgram },
      minCameraRatio: 0.03,
      maxCameraRatio: 8,
      enableEdgeEvents: false,           // 2.5k edges — don't pay for edge hit-testing
      nodeReducer,
      edgeReducer,
    });

    fa2 = new FA2Layout(graph, {
      settings: { ...forceAtlas2.inferSettings(graph), barnesHutOptimize: true, slowDown: 20 },
    });

    wireControls();

    // Keep graph colors in sync with the site theme toggle.
    observer = new MutationObserver(() => {
      const next = currentTheme();
      if (next === pal) return;
      pal = next;
      renderer.setSetting('labelColor', { color: pal.label });
      renderer.setSetting('defaultEdgeColor', pal.edge);
      refresh();
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  }

  // Reducers run on refresh, not per frame.
  //
  // Hover deliberately leaves node colours ALONE. Repainting all ~700 nodes grey
  // every time the pointer crossed one read as flicker, and the grey blobs were
  // harder to look at than the graph itself. Hover now only lights up the edges
  // of the node under the pointer and names its neighbours. Node dimming is kept
  // for search, where washing out non-matches is the whole point.
  function nodeReducer(node: string, data: any) {
    const res: any = { ...data };
    if (hiddenTypes.has(data.kind)) { res.hidden = true; return res; }

    res.color = colorBy === 'track' ? data.colorTrack : data.colorType;

    if (matchSet && !matchSet.has(node)) {
      res.color = pal.dim;
      res.label = '';
      return res;
    }
    if (matchSet) res.forceLabel = true;
    if (focusSet?.has(node)) { res.forceLabel = true; res.zIndex = 1; }
    if (node === focusNode) res.highlighted = true;
    return res;
  }

  function edgeReducer(edge: string, data: any) {
    const res: any = { ...data };
    const s = graph.source(edge);
    const t = graph.target(edge);
    if (hiddenNodes.has(s) || hiddenNodes.has(t)) { res.hidden = true; return res; }

    if (matchSet && !(matchSet.has(s) && matchSet.has(t))) {
      res.color = pal.edgeDim; res.size = 0.6; return res;
    }
    if (focusNode) {
      const incident = s === focusNode || t === focusNode;
      res.color = incident ? pal.edgeHi : pal.edgeDim;
      res.size = incident ? 1.6 : 0.55;
      return res;
    }
    res.color = pal.edge;
    res.size = 0.9;
    return res;
  }

  // Attributes never change here, only the reducers' inputs — skip reindexation.
  // Coalesced to one refresh per frame: a fast pointer sweep fires enterNode /
  // leaveNode far more often than once per frame, and each refresh re-uploads
  // the edge buffers.
  let refreshQueued = false;
  function refresh() {
    if (refreshQueued || !renderer) return;
    refreshQueued = true;
    requestAnimationFrame(() => {
      refreshQueued = false;
      renderer?.refresh({ skipIndexation: true });
    });
  }

  function setFocus(node: string | null) {
    focusNode = node;
    focusSet = node ? new Set([node, ...graph.neighbors(node)]) : null;
    refresh();
  }

  function wireControls() {
    // hover = temporary focus; falls back to the selected node on leave
    renderer.on('enterNode', ({ node }: any) => setFocus(node));
    renderer.on('leaveNode', () => setFocus(selected));

    // click = persistent focus + peek panel (skipped if the click was a drag)
    renderer.on('clickNode', ({ node }: any) => {
      if (didDrag) return;
      selected = node;
      setFocus(node);
      showPeek(graph.getNodeAttributes(node));
    });
    renderer.on('clickStage', () => hidePeek());

    wireDrag();
    wireFilters();
    wireSearch();

    document.getElementById('km-reset')?.addEventListener('click', () => {
      renderer.getCamera().animatedReset({ duration: 400 });
    });
    document.getElementById('km-peek-close')?.addEventListener('click', hidePeek);

    const colorby = document.getElementById('km-colorby') as HTMLSelectElement;
    colorby?.addEventListener('change', () => {
      colorBy = colorby.value === 'track' ? 'track' : 'type';
      refresh();
    });

    // physics on/off — off by default, since the build-time layout is already good
    const physicsBtn = document.getElementById('km-physics');
    physicsBtn?.addEventListener('click', () => {
      clearTimeout(sleepTimer);
      if (fa2.isRunning()) { fa2.stop(); physicsPinned = false; }
      else { fa2.start(); physicsPinned = true; }
      syncPhysicsBtn();
    });

    // collapsible control panel — collapsed by default on small screens.
    const panel = document.getElementById('km-panel');
    const toggle = document.getElementById('km-panel-toggle');
    if (panel && window.matchMedia('(max-width: 767px)').matches) panel.classList.add('km-collapsed');
    toggle?.addEventListener('click', () => panel?.classList.toggle('km-collapsed'));
  }

  let physicsPinned = false;   // true when the user turned physics on explicitly
  let dragged: string | null = null;
  let didDrag = false;

  function syncPhysicsBtn() {
    const btn = document.getElementById('km-physics');
    if (!btn) return;
    const on = !!fa2?.isRunning();
    btn.classList.toggle('km-on', on);
    btn.title = on ? 'Physics: đang chạy — click để tắt' : 'Physics: tắt (kéo node vẫn tạm bật)';
  }

  /** Drag a node and the graph settles around it, then physics goes back to sleep. */
  function wireDrag() {
    renderer.on('downNode', ({ node }: any) => {
      dragged = node;
      didDrag = false;
      clearTimeout(sleepTimer);
      graph.setNodeAttribute(node, 'highlighted', true);
      // Freeze the auto-fit box so dragging a node outside it doesn't zoom the view.
      if (!renderer.getCustomBBox()) renderer.setCustomBBox(renderer.getBBox());
    });

    renderer.on('moveBody', ({ event }: any) => {
      if (!dragged) return;
      // Wake physics on the first real movement, not on a plain click.
      if (!didDrag) {
        didDrag = true;
        if (!fa2.isRunning()) { fa2.start(); syncPhysicsBtn(); }
      }
      const pos = renderer.viewportToGraph(event);
      graph.setNodeAttribute(dragged, 'x', pos.x);
      graph.setNodeAttribute(dragged, 'y', pos.y);
      event.preventSigmaDefault();
      event.original.preventDefault();
      event.original.stopPropagation();
    });

    const drop = () => {
      if (!dragged) return;
      graph.removeNodeAttribute(dragged, 'highlighted');
      dragged = null;
      if (didDrag && !physicsPinned) {
        // let the neighbourhood relax, then stop burning CPU
        sleepTimer = setTimeout(() => { fa2?.stop(); syncPhysicsBtn(); }, 1400);
      }
    };
    renderer.on('upNode', drop);
    renderer.on('upStage', drop);
  }

  function wireFilters() {
    document.querySelectorAll('.km-legend-item').forEach((btn) => {
      btn.addEventListener('click', () => {
        const t = (btn as HTMLElement).dataset.type!;
        if (hiddenTypes.has(t)) { hiddenTypes.delete(t); btn.classList.remove('opacity-40'); }
        else { hiddenTypes.add(t); btn.classList.add('opacity-40'); }
        hiddenNodes.clear();
        graph.forEachNode((n: string, a: any) => { if (hiddenTypes.has(a.kind)) hiddenNodes.add(n); });
        refresh();
      });
    });
  }

  function wireSearch() {
    const search = document.getElementById('km-search') as HTMLInputElement;
    const hits = (q: string) => {
      const out: string[] = [];
      graph.forEachNode((n: string, a: any) => {
        if (a.label?.toLowerCase().includes(q)) out.push(n);
      });
      return out;
    };

    search?.addEventListener('input', () => {
      const q = search.value.trim().toLowerCase();
      matchSet = q ? new Set(hits(q)) : null;
      refresh();
    });

    search?.addEventListener('keydown', (e: any) => {
      if (e.key !== 'Enter') return;
      const q = search.value.trim().toLowerCase();
      if (!q) return;
      const first = hits(q)[0];
      if (!first) return;
      const d = renderer.getNodeDisplayData(first);
      if (d) renderer.getCamera().animate({ x: d.x, y: d.y, ratio: 0.15 }, { duration: 450 });
    });
  }

  function showPeek(a: any) {
    const peek = document.getElementById('km-peek'); if (!peek) return;
    (document.getElementById('km-peek-dot') as HTMLElement).style.background =
      colorBy === 'track' ? a.colorTrack : a.colorType;
    (document.getElementById('km-peek-type') as HTMLElement).textContent = a.kind || '';
    (document.getElementById('km-peek-title') as HTMLElement).textContent = a.full || a.label || '';
    (document.getElementById('km-peek-summary') as HTMLElement).textContent = a.summary || '';
    (document.getElementById('km-peek-link') as HTMLAnchorElement).href = a.url || '#';
    peek.classList.remove('hidden');
  }

  function hidePeek() {
    document.getElementById('km-peek')?.classList.add('hidden');
    selected = null;
    setFocus(null);
  }

  function teardown() {
    clearTimeout(sleepTimer);
    observer?.disconnect(); observer = null;
    fa2?.kill(); fa2 = null;
    renderer?.kill(); renderer = null;
    graph = null;
    selected = null; focusNode = null; focusSet = null; matchSet = null;
    refreshQueued = false;
    hiddenTypes.clear(); hiddenNodes.clear();
    physicsPinned = false; dragged = null; didDrag = false;
  }

  document.addEventListener('astro:before-swap', teardown);
  document.addEventListener('astro:page-load', renderGraph);
</script>
