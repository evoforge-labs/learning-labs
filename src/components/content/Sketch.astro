---
// Hand-drawn ink sketch illustration for a concept page.
// Images live in public/sketches/<track>/<slug>.webp and are pre-sized to 1000px.
interface Props { src: string; alt: string; caption?: string }
const { src, alt, caption } = Astro.props;
---
<figure class="my-8 not-prose">
  <div class="overflow-hidden rounded-xl border border-zinc-200 bg-[#f7f4ee] dark:border-zinc-700">
    <img src={src} alt={alt} width="1000" height="1000" loading="lazy" decoding="async"
         class="h-auto w-full dark:opacity-90" />
  </div>
  {caption && <figcaption class="mt-2 text-center text-sm italic text-zinc-500 dark:text-zinc-400">{caption}</figcaption>}
</figure>
