---
import BaseLayout from './BaseLayout.astro';
import { ArrowLeft } from '@lucide/astro';
interface Props {
  title: string;
  kicker?: string;
  kickerColor?: string;
  trackLabel?: string;
  description?: string;
  headings?: { text: string; slug: string }[];
}
const { title, kicker, kickerColor, trackLabel, description, headings = [] } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <div id="read-progress"></div>
  <div class="border-b border-stone-200/80 dark:border-stone-800/80">
    <div class="max-w-5xl mx-auto px-4 h-12 flex items-center">
      <a href="javascript:history.back()" aria-label="Quay lại" class="w-9 h-9 grid place-items-center rounded-lg hover:bg-stone-200/60 dark:hover:bg-stone-800/80 text-stone-500 transition-colors active:scale-95"><ArrowLeft class="w-4 h-4" /></a>
      {trackLabel && <div class="mx-auto text-xs uppercase tracking-[0.08em] text-stone-400 dark:text-stone-500">{trackLabel}</div>}
      <div class="w-9"></div>
    </div>
  </div>
  {headings.length > 0 && (
    <div class="toc-wrap hidden xl:block fixed right-8 top-1/2 -translate-y-1/2 z-40">
      <div class="toc-handle space-y-1.5 cursor-pointer transition ml-auto w-6"><div class="w-6 h-0.5 bg-stone-400/70 rounded"></div><div class="w-5 h-0.5 bg-stone-400/70 rounded ml-1"></div><div class="w-6 h-0.5 bg-stone-400/70 rounded"></div></div>
      <div class="toc-panel absolute right-0 top-1/2 -translate-y-1/2 w-64 rounded-xl ring-1 ring-stone-200 dark:ring-stone-800 bg-white dark:bg-stone-900 shadow-xl shadow-stone-900/5 dark:shadow-black/30 p-4 text-sm">
        <div class="eyebrow mb-3">nội dung</div>
        <ul class="space-y-2 text-stone-500 dark:text-stone-400">{headings.map((h) => <li><a href={`#${h.slug}`} class="hover:text-brand transition-colors">{h.text}</a></li>)}</ul>
      </div>
    </div>
  )}
  <article id="main" class="max-w-[680px] mx-auto px-5 pt-12 sm:pt-16 pb-24">
    {kicker && (
      <div class="anim flex items-center gap-2.5 mb-5">
        <span class="inline-block h-4 w-[3px] rounded-full" style={`background:${kickerColor ?? 'var(--color-brand)'}`}></span>
        <span class="text-xs font-semibold uppercase tracking-[0.14em]" style={`color:${kickerColor ?? 'var(--color-brand)'}`}>{kicker}</span>
      </div>
    )}
    <h1 class="anim font-read text-[2.4rem] sm:text-[2.85rem] leading-[1.08] font-bold tracking-[-0.02em] text-stone-900 dark:text-stone-100">{title}</h1>
    <slot />
  </article>
  <script>
    // thin ink progress line at the very top of the viewport
    function bindProgress() {
      const bar = document.getElementById('read-progress');
      if (!bar) return;
      const update = () => {
        const total = document.documentElement.scrollHeight - innerHeight;
        bar.style.transform = `scaleX(${total > 0 ? Math.min(1, scrollY / total) : 0})`;
      };
      addEventListener('scroll', update, { passive: true });
      update();
    }
    bindProgress();
    document.addEventListener('astro:page-load', bindProgress);
  </script>
</BaseLayout>
